<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Asset Tracker – Aktien, ETF & Rohstoffe</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #0f1419;
      --bg-card: #1a2028;
      --bg-card-hover: #222a34;
      --border: #2a3340;
      --text: #e6e9ed;
      --text-dim: #8b96a7;
      --accent: #4a9eff;
      --green: #26c281;
      --red: #ef5350;
      --shadow: 0 4px 12px rgba(0,0,0,0.3);
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f5f7fa;
        --bg-card: #ffffff;
        --bg-card-hover: #f0f3f7;
        --border: #e2e8f0;
        --text: #1a202c;
        --text-dim: #64748b;
        --shadow: 0 2px 8px rgba(0,0,0,0.08);
      }
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }
    header {
      padding: 24px 32px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    h1 {
      font-size: 24px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .add-form {
      display: flex;
      gap: 8px;
      align-items: center;
      position: relative;
    }
    input[type="text"] {
      background: var(--bg-card);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 9px 14px;
      border-radius: 8px;
      font-size: 14px;
      width: 280px;
    }
    input[type="text"]:focus {
      outline: none;
      border-color: var(--accent);
    }
    button {
      background: var(--accent);
      color: white;
      border: none;
      padding: 9px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    button:hover { opacity: 0.88; }
    button.ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
    }
    button.ghost:hover { color: var(--text); border-color: var(--text-dim); }
    .search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-top: 4px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      max-height: 300px;
      overflow-y: auto;
      z-index: 100;
      box-shadow: var(--shadow);
      display: none;
    }
    .search-results.open { display: block; }
    .search-item {
      padding: 10px 14px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .search-item:last-child { border: none; }
    .search-item:hover { background: var(--bg-card-hover); }
    .search-item .sym { font-weight: 600; }
    .search-item .name { color: var(--text-dim); font-size: 12px; margin-top: 2px; }
    main { padding: 24px 32px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
    }
    .card:hover {
      background: var(--bg-card-hover);
      border-color: var(--accent);
      transform: translateY(-1px);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
    }
    .card-title { flex: 1; min-width: 0; }
    .card-symbol {
      font-size: 13px;
      color: var(--text-dim);
      font-weight: 500;
    }
    .card-name {
      font-size: 15px;
      font-weight: 600;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-remove {
      background: transparent;
      border: none;
      color: var(--text-dim);
      padding: 4px 8px;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .card:hover .card-remove { opacity: 1; }
    .card-remove:hover { color: var(--red); }
    .card-price {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .card-currency {
      font-size: 13px;
      color: var(--text-dim);
      font-weight: 500;
      margin-left: 4px;
    }
    .card-changes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }
    .change {
      text-align: center;
    }
    .change-label {
      font-size: 11px;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }
    .change-value {
      font-size: 13px;
      font-weight: 600;
    }
    .up { color: var(--green); }
    .down { color: var(--red); }
    .flat { color: var(--text-dim); }
    .loading {
      text-align: center;
      color: var(--text-dim);
      padding: 20px;
      font-size: 13px;
    }
    .error-msg {
      color: var(--red);
      font-size: 12px;
      margin-top: 8px;
    }
    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 200;
      display: none;
      align-items: flex-start;
      justify-content: center;
      overflow-y: auto;
      padding: 24px;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      width: 100%;
      max-width: 960px;
      padding: 24px;
      box-shadow: var(--shadow);
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 20px;
      gap: 16px;
    }
    .modal-title h2 {
      font-size: 22px;
      font-weight: 600;
    }
    .modal-title .sub {
      color: var(--text-dim);
      font-size: 13px;
      margin-top: 2px;
    }
    .modal-close {
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 24px;
      cursor: pointer;
      line-height: 1;
      padding: 4px 10px;
    }
    .modal-close:hover { color: var(--text); }
    .range-tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .tab {
      background: transparent;
      color: var(--text-dim);
      border: none;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      border-radius: 0;
    }
    .tab:hover { color: var(--text); }
    .tab.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    .chart-wrap {
      position: relative;
      height: 340px;
      margin-bottom: 24px;
    }
    .news-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }
    .news-list { list-style: none; }
    .news-item {
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }
    .news-item:last-child { border: none; }
    .news-item a {
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
      display: block;
    }
    .news-item a:hover { color: var(--accent); }
    .news-meta {
      font-size: 12px;
      color: var(--text-dim);
      margin-top: 4px;
    }
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-dim);
    }
    @media (max-width: 640px) {
      header { padding: 16px; }
      main { padding: 16px; }
      input[type="text"] { width: 180px; }
      .modal { padding: 16px; }
      .chart-wrap { height: 260px; }
    }
  </style>
</head>
<body>
  <header>
    <h1>📈 Asset Tracker</h1>
    <div class="add-form">
      <input type="text" id="search-input" placeholder="Symbol oder Name suchen (z.B. AAPL, SAP, Gold)" autocomplete="off">
      <button id="add-btn">Hinzufügen</button>
      <div class="search-results" id="search-results"></div>
    </div>
  </header>

  <main>
    <div class="grid" id="grid"></div>
  </main>

  <div class="modal-backdrop" id="modal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">
          <h2 id="modal-name"></h2>
          <div class="sub" id="modal-sub"></div>
        </div>
        <button class="modal-close" id="modal-close">×</button>
      </div>
      <div class="range-tabs" id="range-tabs">
        <button class="tab" data-range="1y">1 Jahr</button>
        <button class="tab" data-range="3y">3 Jahre</button>
        <button class="tab" data-range="5y">5 Jahre</button>
        <button class="tab" data-range="10y">10 Jahre</button>
        <button class="tab" data-range="15y">15 Jahre</button>
      </div>
      <div class="chart-wrap"><canvas id="chart"></canvas></div>
      <div class="news-title">Aktuelle News</div>
      <ul class="news-list" id="news-list"></ul>
    </div>
  </div>

  <script>
    const DEFAULT_ASSETS = [
      { symbol: "AAPL",    name: "Apple Inc.",             type: "stock" },
      { symbol: "MSFT",    name: "Microsoft Corp.",        type: "stock" },
      { symbol: "SAP.DE",  name: "SAP SE",                 type: "stock" },
      { symbol: "NVDA",    name: "NVIDIA Corp.",           type: "stock" },
      { symbol: "SPY",     name: "S&P 500 ETF",            type: "etf"   },
      { symbol: "EUNL.DE", name: "iShares MSCI World",     type: "etf"   },
      { symbol: "GC=F",    name: "Gold",                   type: "commodity" },
      { symbol: "SI=F",    name: "Silber",                 type: "commodity" },
      { symbol: "CL=F",    name: "WTI Crude Oil",          type: "commodity" },
    ];

    const STORAGE_KEY = "asset_tracker_v1";
    const RANGE_CONFIG = {
      "1y":  { range: "1y",  interval: "1d"  },
      "3y":  { range: "2y",  interval: "1wk", override: 3 },
      "5y":  { range: "5y",  interval: "1wk" },
      "10y": { range: "10y", interval: "1mo" },
      "15y": { range: "max", interval: "1mo", override: 15 },
    };

    let assets = loadAssets();
    let chart = null;
    let current = null;

    function loadAssets() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) return JSON.parse(stored);
      } catch (e) {}
      localStorage.setItem(STORAGE_KEY, JSON.stringify(DEFAULT_ASSETS));
      return [...DEFAULT_ASSETS];
    }

    function saveAssets() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(assets));
    }

    function fmtPrice(v, currency) {
      if (v == null || isNaN(v)) return "–";
      const n = Number(v);
      const digits = n >= 1000 ? 2 : n >= 10 ? 2 : 4;
      return n.toLocaleString("de-DE", { minimumFractionDigits: digits, maximumFractionDigits: digits });
    }

    function fmtChange(pct) {
      if (pct == null || isNaN(pct)) return "–";
      const sign = pct > 0 ? "+" : "";
      return sign + pct.toFixed(2) + "%";
    }

    function changeClass(pct) {
      if (pct == null || isNaN(pct)) return "flat";
      if (pct > 0.05) return "up";
      if (pct < -0.05) return "down";
      return "flat";
    }

    async function api(path, params) {
      const qs = new URLSearchParams(params).toString();
      const res = await fetch(path + "?" + qs, { headers: { "Accept": "application/json" } });
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      return data;
    }

    async function fetchCardData(symbol) {
      const data = await api("/asset-tracker/chart", { symbol, range: "3mo", interval: "1d" });
      const result = data.chart && data.chart.result && data.chart.result[0];
      if (!result) throw new Error("Keine Daten verfügbar");
      const meta = result.meta || {};
      const ts = result.timestamp || [];
      const closes = (result.indicators && result.indicators.quote && result.indicators.quote[0].close) || [];
      const valid = ts.map((t, i) => ({ t: t * 1000, c: closes[i] })).filter(p => p.c != null);
      const price = meta.regularMarketPrice != null ? meta.regularMarketPrice : (valid.length ? valid[valid.length - 1].c : null);
      const now = Date.now();
      const findClose = (daysBack) => {
        const target = now - daysBack * 86400000;
        let best = null, bestDiff = Infinity;
        for (const p of valid) {
          if (p.t > now - 6 * 3600000) continue;
          const diff = Math.abs(p.t - target);
          if (diff < bestDiff) { bestDiff = diff; best = p.c; }
        }
        return best;
      };
      const prev1d = meta.chartPreviousClose != null ? meta.chartPreviousClose :
                    (valid.length >= 2 ? valid[valid.length - 2].c : null);
      const prev1w = findClose(7);
      const prev1m = findClose(30);
      const pct = (curr, prev) => (curr != null && prev != null && prev !== 0) ? ((curr - prev) / prev) * 100 : null;
      return {
        price,
        currency: meta.currency || "",
        name: meta.longName || meta.shortName || symbol,
        changes: {
          "1d": pct(price, prev1d),
          "1w": pct(price, prev1w),
          "1m": pct(price, prev1m),
        }
      };
    }

    async function fetchChartData(symbol, rangeKey) {
      const cfg = RANGE_CONFIG[rangeKey];
      const data = await api("/asset-tracker/chart", { symbol, range: cfg.range, interval: cfg.interval });
      const result = data.chart && data.chart.result && data.chart.result[0];
      if (!result) throw new Error("Keine Daten verfügbar");
      const ts = result.timestamp || [];
      const closes = (result.indicators && result.indicators.quote && result.indicators.quote[0].close) || [];
      let points = ts.map((t, i) => ({ x: t * 1000, y: closes[i] })).filter(p => p.y != null);
      if (cfg.override) {
        const cutoff = Date.now() - cfg.override * 365.25 * 86400000;
        points = points.filter(p => p.x >= cutoff);
      }
      return { points, currency: (result.meta && result.meta.currency) || "" };
    }

    async function fetchNewsData(symbol) {
      const data = await api("/asset-tracker/news", { symbol });
      return (data.news || []).slice(0, 10);
    }

    function renderGrid() {
      const grid = document.getElementById("grid");
      if (assets.length === 0) {
        grid.innerHTML = '<div class="empty-state">Keine Posten. Füge oben einen hinzu.</div>';
        return;
      }
      grid.innerHTML = assets.map(a => `
        <div class="card" data-symbol="${a.symbol}">
          <div class="card-header">
            <div class="card-title">
              <div class="card-symbol">${a.symbol}</div>
              <div class="card-name" title="${a.name}">${a.name}</div>
            </div>
            <button class="card-remove" data-remove="${a.symbol}" title="Entfernen">×</button>
          </div>
          <div class="card-price" data-price="${a.symbol}">
            <span class="loading">Lädt…</span>
          </div>
          <div class="card-changes" data-changes="${a.symbol}"></div>
        </div>
      `).join("");

      grid.querySelectorAll(".card").forEach(el => {
        el.addEventListener("click", e => {
          if (e.target.closest("[data-remove]")) return;
          openDetail(el.dataset.symbol);
        });
      });
      grid.querySelectorAll("[data-remove]").forEach(el => {
        el.addEventListener("click", e => {
          e.stopPropagation();
          removeAsset(el.dataset.remove);
        });
      });

      assets.forEach(a => loadCard(a.symbol));
    }

    async function loadCard(symbol) {
      const priceEl = document.querySelector(`[data-price="${CSS.escape(symbol)}"]`);
      const changesEl = document.querySelector(`[data-changes="${CSS.escape(symbol)}"]`);
      if (!priceEl || !changesEl) return;
      try {
        const d = await fetchCardData(symbol);
        priceEl.innerHTML = `${fmtPrice(d.price)}<span class="card-currency">${d.currency}</span>`;
        changesEl.innerHTML = `
          <div class="change">
            <div class="change-label">1T</div>
            <div class="change-value ${changeClass(d.changes["1d"])}">${fmtChange(d.changes["1d"])}</div>
          </div>
          <div class="change">
            <div class="change-label">1W</div>
            <div class="change-value ${changeClass(d.changes["1w"])}">${fmtChange(d.changes["1w"])}</div>
          </div>
          <div class="change">
            <div class="change-label">1M</div>
            <div class="change-value ${changeClass(d.changes["1m"])}">${fmtChange(d.changes["1m"])}</div>
          </div>
        `;
        const asset = assets.find(a => a.symbol === symbol);
        if (asset && d.name && asset.name === symbol) {
          asset.name = d.name;
          saveAssets();
          const nameEl = document.querySelector(`[data-symbol="${CSS.escape(symbol)}"] .card-name`);
          if (nameEl) nameEl.textContent = d.name;
        }
      } catch (err) {
        priceEl.innerHTML = `<span class="error-msg">Fehler: ${err.message}</span>`;
        changesEl.innerHTML = "";
      }
    }

    async function openDetail(symbol) {
      const asset = assets.find(a => a.symbol === symbol);
      if (!asset) return;
      current = { symbol, range: "1y" };
      document.getElementById("modal-name").textContent = asset.name;
      document.getElementById("modal-sub").textContent = symbol;
      document.getElementById("news-list").innerHTML = '<li class="loading">Lädt…</li>';
      document.getElementById("modal").classList.add("open");
      updateTabs();
      await drawChart();
      await loadNews(symbol);
    }

    function closeDetail() {
      document.getElementById("modal").classList.remove("open");
      if (chart) { chart.destroy(); chart = null; }
      current = null;
    }

    function updateTabs() {
      document.querySelectorAll(".tab").forEach(t => {
        t.classList.toggle("active", t.dataset.range === current.range);
      });
    }

    async function drawChart() {
      const ctx = document.getElementById("chart");
      if (chart) { chart.destroy(); chart = null; }
      const parent = ctx.parentElement;
      parent.insertAdjacentHTML("beforeend", '<div class="loading" id="chart-loading">Lädt…</div>');
      try {
        const d = await fetchChartData(current.symbol, current.range);
        document.getElementById("chart-loading")?.remove();
        const isUp = d.points.length >= 2 && d.points[d.points.length - 1].y >= d.points[0].y;
        const color = isUp ? "#26c281" : "#ef5350";
        chart = new Chart(ctx, {
          type: "line",
          data: {
            datasets: [{
              label: current.symbol,
              data: d.points,
              borderColor: color,
              backgroundColor: color + "22",
              borderWidth: 2,
              fill: true,
              tension: 0.15,
              pointRadius: 0,
              pointHoverRadius: 4,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: "index" },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: items => new Date(items[0].parsed.x).toLocaleDateString("de-DE"),
                  label: item => `${fmtPrice(item.parsed.y)} ${d.currency}`,
                }
              }
            },
            scales: {
              x: {
                type: "time",
                time: { unit: current.range === "1y" ? "month" : "year" },
                grid: { color: "rgba(128,128,128,0.1)" },
                ticks: { color: "#8b96a7" },
              },
              y: {
                grid: { color: "rgba(128,128,128,0.1)" },
                ticks: { color: "#8b96a7", callback: v => fmtPrice(v) },
              }
            }
          }
        });
      } catch (err) {
        document.getElementById("chart-loading")?.remove();
        parent.insertAdjacentHTML("beforeend", `<div class="loading error-msg">Chart-Fehler: ${err.message}</div>`);
      }
    }

    async function loadNews(symbol) {
      const list = document.getElementById("news-list");
      try {
        const news = await fetchNewsData(symbol);
        if (!news.length) {
          list.innerHTML = '<li class="loading">Keine News verfügbar.</li>';
          return;
        }
        list.innerHTML = news.map(n => {
          const date = n.providerPublishTime ? new Date(n.providerPublishTime * 1000).toLocaleDateString("de-DE") : "";
          return `<li class="news-item">
            <a href="${n.link}" target="_blank" rel="noopener">${n.title}</a>
            <div class="news-meta">${n.publisher || ""}${date ? " · " + date : ""}</div>
          </li>`;
        }).join("");
      } catch (err) {
        list.innerHTML = `<li class="loading error-msg">News-Fehler: ${err.message}</li>`;
      }
    }

    function addAsset(symbol, name) {
      symbol = symbol.trim().toUpperCase();
      if (!symbol) return;
      if (assets.some(a => a.symbol === symbol)) {
        alert("Dieser Posten ist bereits in der Liste.");
        return;
      }
      assets.push({ symbol, name: name || symbol, type: "custom" });
      saveAssets();
      renderGrid();
    }

    function removeAsset(symbol) {
      if (!confirm(`"${symbol}" aus der Liste entfernen?`)) return;
      assets = assets.filter(a => a.symbol !== symbol);
      saveAssets();
      renderGrid();
    }

    let searchTimer = null;
    function setupSearch() {
      const input = document.getElementById("search-input");
      const results = document.getElementById("search-results");
      const addBtn = document.getElementById("add-btn");

      input.addEventListener("input", () => {
        clearTimeout(searchTimer);
        const q = input.value.trim();
        if (q.length < 2) { results.classList.remove("open"); return; }
        searchTimer = setTimeout(async () => {
          try {
            const data = await api("/asset-tracker/search", { q });
            const quotes = (data.quotes || []).filter(q => q.symbol);
            if (!quotes.length) { results.classList.remove("open"); return; }
            results.innerHTML = quotes.map(q => `
              <div class="search-item" data-sym="${q.symbol}" data-name="${(q.shortname || q.longname || q.symbol).replace(/"/g, "&quot;")}">
                <div class="sym">${q.symbol} <span style="color:var(--text-dim);font-weight:400;font-size:11px">${q.quoteType || ""} · ${q.exchange || ""}</span></div>
                <div class="name">${q.shortname || q.longname || ""}</div>
              </div>
            `).join("");
            results.classList.add("open");
            results.querySelectorAll(".search-item").forEach(el => {
              el.addEventListener("click", () => {
                addAsset(el.dataset.sym, el.dataset.name);
                input.value = "";
                results.classList.remove("open");
              });
            });
          } catch (e) {
            results.classList.remove("open");
          }
        }, 300);
      });

      addBtn.addEventListener("click", () => {
        if (input.value.trim()) {
          addAsset(input.value.trim(), input.value.trim());
          input.value = "";
          results.classList.remove("open");
        }
      });

      input.addEventListener("keydown", e => {
        if (e.key === "Enter") { e.preventDefault(); addBtn.click(); }
        if (e.key === "Escape") { results.classList.remove("open"); }
      });

      document.addEventListener("click", e => {
        if (!e.target.closest(".add-form")) results.classList.remove("open");
      });
    }

    function setupModal() {
      document.getElementById("modal-close").addEventListener("click", closeDetail);
      document.getElementById("modal").addEventListener("click", e => {
        if (e.target.id === "modal") closeDetail();
      });
      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && current) closeDetail();
      });
      document.querySelectorAll(".tab").forEach(tab => {
        tab.addEventListener("click", async () => {
          if (!current) return;
          current.range = tab.dataset.range;
          updateTabs();
          await drawChart();
        });
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      setupSearch();
      setupModal();
      renderGrid();
    });
  </script>
</body>
</html>
